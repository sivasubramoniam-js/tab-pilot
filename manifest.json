{
  "manifest_version": 3,
  "name": "Tab Pilot",
  "version": "1.0.0",
  "description": "Intelligently monitor, organize, and manage your browser tabs — track inactive tabs, get smart notifications, launch tab groups, and reclaim memory.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    },
    "default_title": "Tab Pilot"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "history",
    "notifications",
    "alarms"
  ],
  "incognito": "spanning",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Open Tab Pilot"
    },
    "close-stale-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Close all stale tabs"
    }
  }
}
